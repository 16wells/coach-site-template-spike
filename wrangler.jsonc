{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "coach-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [{ "binding": "DB", "database_name": "coach-site-db" }],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "coach-site-media" }],
	"kv_namespaces": [{ "binding": "SESSION" }],
	"triggers": { "crons": ["*/15 * * * *"] },
	"previews": {
		"d1_databases": [{ "binding": "DB", "database_name": "coach-site-db-staging" }],
		"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "coach-site-media-staging" }],
		"kv_namespaces": [{ "binding": "SESSION" }]
	}
}
